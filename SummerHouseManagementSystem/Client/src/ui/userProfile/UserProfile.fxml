<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.userProfile.UserProfileCtrl">
   <top>
      <Label text="User Profile" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
         <BorderPane.margin>
            <Insets top="20.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <center>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <HBox spacing="10.0">
               <children>
                  <Label prefWidth="100.0" text="Username:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="usernameLabel" text="Loading...">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label prefWidth="100.0" text="Email:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="emailLabel" text="Loading...">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label prefWidth="100.0" text="User Type:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="userTypeLabel" text="Loading...">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children></HBox>
            <HBox spacing="10.0">
               <children>
                  <Label text="New password: " />
                  <TextField fx:id="newPasswordField" alignment="CENTER" />
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Label text="Repeat password: " />
                  <TextField fx:id="repeatPasswordField" alignment="CENTER" />
               </children>
            </HBox>
            <Label fx:id="messageLabel" textFill="RED" />
         </children>
         <padding>
            <Insets bottom="20.0" left="50.0" right="50.0" top="20.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#onBack" prefWidth="100.0" text="Back" />
            <Button mnemonicParsing="false" onAction="#onDeleteAccount" text="Delete Account" />
            <Button fx:id="buttonSave" mnemonicParsing="false" onAction="#onSave" text="Update Password" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
