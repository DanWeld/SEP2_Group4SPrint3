<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.adminPropertyList.AdminPropertyListCtrl">
   <top>
      <Label text="Manage Properties" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
         <BorderPane.margin>
            <Insets top="20.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="propertyTable" prefHeight="300.0">
               <columns>
                  <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Name" />
                  <TableColumn fx:id="addressColumn" prefWidth="300.0" text="Address" />
                  <TableColumn fx:id="bedroomsColumn" prefWidth="100.0" text="Bedrooms" />
                  <TableColumn fx:id="bathroomsColumn" prefWidth="100.0" text="Bathrooms" />
                  <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Price/Night" />
               </columns>
            </TableView>
            <HBox spacing="10.0">
               <children>
                  <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Name:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="propertyNameField" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Description:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextArea fx:id="descriptionArea" prefHeight="80.0" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Address:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="addressField" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Bedrooms:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Spinner fx:id="bedroomsSpinner" />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Bathrooms:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Spinner fx:id="bathroomsSpinner" />
                           </children>
                        </HBox>
                        <HBox spacing="10.0">
                           <children>
                              <Label prefWidth="100.0" text="Price/Night:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="priceField" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" spacing="20.0" prefWidth="150.0">
                     <children>
                        <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAddProperty" prefHeight="40.0" prefWidth="120.0" text="Add New" />
                        <Button fx:id="updateButton" mnemonicParsing="false" onAction="#onUpdateProperty" prefHeight="40.0" prefWidth="120.0" text="Update" />
                        <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#onDeleteProperty" prefHeight="40.0" prefWidth="120.0" text="Delete" />
                        <Button fx:id="viewHistoryButton" mnemonicParsing="false" onAction="#onViewHistory" prefHeight="40.0" prefWidth="120.0" text="View History" />
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
            <Label fx:id="messageLabel" textFill="RED">
               <font>
                  <Font size="14.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#onBack" prefHeight="40.0" prefWidth="100.0" text="Back" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
