<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.userProfile.UserProfileController">
   <top>
      <HBox alignment="CENTER" prefHeight="80.0" prefWidth="200.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
         <children>
            <Label text="User Profile" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="30.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="TOP_CENTER" prefHeight="888.0" prefWidth="773.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="errorLabel" style="-fx-text-fill: red;" wrapText="true" />
            
            <!-- View Profile Mode -->
            <VBox fx:id="profileViewBox" alignment="BOTTOM_CENTER" prefHeight="276.0" prefWidth="760.0" spacing="15.0">
               <children>
                  <HBox alignment="CENTER" prefHeight="264.0" prefWidth="760.0" spacing="15.0">
                     <children>
                        <VBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="20.0">
                           <children>
                              <Label text="Name:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Username:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label prefWidth="51.0" text="Email:" textFill="#c3b9b9">
                                 <font>
                                    <Font name="System Bold" size="18.0" />
                                 </font>
                              </Label>
                              <Label text="Phone:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Address:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox alignment="CENTER_LEFT" prefHeight="250.0" prefWidth="499.0" spacing="20.0">
               <children>
                  <Label fx:id="nameLabel" text="Name">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="usernameLabel" text="Username">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="emailLabel" text="Email">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label text="Bio:">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="30.0" />
                     </VBox.margin>
                  </Label>
                  <TextArea fx:id="bioTextArea" editable="false" opacity="0.2" prefHeight="28.0" prefWidth="355.0" wrapText="true">
                     <font>
                        <Font size="9.0" />
                     </font>
                  </TextArea>
                  <Label fx:id="phoneLabel" text="Phone">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="addressLabel" text="Address">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <HBox alignment="CENTER" prefHeight="30.0" prefWidth="764.0" spacing="20.0">
               <children>
                  <Button fx:id="editButton" mnemonicParsing="false" onAction="#onEditClick" prefWidth="150.0" style="-fx-background-color: #3498db;" text="Edit Profile" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="changePasswordButton" mnemonicParsing="false" onAction="#onChangePasswordClick" prefWidth="150.0" style="-fx-background-color: #f39c12;" text="Change Password" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="deleteAccountButton" mnemonicParsing="false" onAction="#onDeleteAccountClick" prefWidth="150.0" style="-fx-background-color: #e74c3c;" text="Delete Account" textFill="WHITE">
                     <font>
                            <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
            
            <!-- Edit Profile Mode -->
            <VBox fx:id="editProfileBox" alignment="TOP_CENTER" spacing="15.0" visible="false">
               <children>
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <VBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="20.0">
                           <children>
                              <Label text="Name:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Username:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Email:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Bio:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                                 <VBox.margin>
                                    <Insets top="30.0" />
                                 </VBox.margin>
                              </Label>
                              <Label text="Phone:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Address:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" prefWidth="300.0" spacing="20.0">
                           <children>
                              <TextField fx:id="nameTextField" promptText="Enter your name" />
                              <Label fx:id="usernameEditLabel" text="Username">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <Label fx:id="emailEditLabel" text="Email">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Label>
                              <TextArea fx:id="bioTextArea" prefHeight="80.0" prefWidth="300.0" promptText="Tell us about yourself" wrapText="true" />
                              <TextField fx:id="phoneTextField" promptText="Enter your phone number" />
                              <TextField fx:id="addressTextField" promptText="Enter your address" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" spacing="20.0">
                     <children>
                        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#onSaveClick" prefWidth="100.0" style="-fx-background-color: #2ecc71;" text="Save" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                        <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancelClick" prefWidth="100.0" style="-fx-background-color: #e74c3c;" text="Cancel" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
            
            <!-- Change Password Mode -->
            <VBox fx:id="changePasswordBox" alignment="TOP_CENTER" spacing="15.0" visible="false">
               <children>
                  <Label text="Change Password" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <VBox alignment="CENTER_RIGHT" prefWidth="200.0" spacing="20.0">
                           <children>
                              <Label text="Current Password:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="New Password:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <Label text="Confirm Password:">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" prefWidth="300.0" spacing="20.0">
                           <children>
                              <PasswordField fx:id="currentPasswordField" promptText="Enter current password" />
                              <PasswordField fx:id="newPasswordField" promptText="Enter new password" />
                              <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" spacing="20.0">
                     <children>
                        <Button fx:id="submitPasswordButton" mnemonicParsing="false" onAction="#onSubmitPasswordClick" prefWidth="100.0" style="-fx-background-color: #2ecc71;" text="Submit" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                        <Button fx:id="cancelPasswordButton" mnemonicParsing="false" onAction="#onCancelPasswordClick" prefWidth="100.0" style="-fx-background-color: #e74c3c;" text="Cancel" textFill="WHITE">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                     </children>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
