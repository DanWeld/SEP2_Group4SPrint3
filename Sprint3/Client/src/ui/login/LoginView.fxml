<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity"
      minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0"
      prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.login.LoginCtrl">
    <children>
        <Label text="Login">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>
        <VBox alignment="CENTER" prefHeight="211.0" prefWidth="580.0"
              spacing="10.0">
            <children>
                <Label text="Email:">
                    <VBox.margin>
                        <Insets/>
                    </VBox.margin>
                </Label>
                <TextField fx:id="emailField" promptText="Enter your email">
                    <VBox.margin>
                        <Insets left="150.0" right="150.0"/>
                    </VBox.margin>
                </TextField>
                <Label text="Password:"/>
                <PasswordField fx:id="passwordField"
                               promptText="Enter your password">
                    <VBox.margin>
                        <Insets left="150.0" right="150.0"/>
                    </VBox.margin>
                </PasswordField>
                <Label fx:id="messageLabel" textFill="RED">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
            </children>
        </VBox>
        <HBox alignment="CENTER" prefHeight="62.0" prefWidth="580.0"
              spacing="20.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onBack" text="Back"/>
                <Button mnemonicParsing="false" onAction="#onLogin" text="Login"
                        fx:id="loginButton"/>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</VBox>
